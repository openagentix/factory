{
    "name": "oxf-web",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "license": "Apache-2.0",
    "packageManager": "pnpm@11.13.1",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "prebuild": "node scripts/fonts.mjs",
        "build": "vite build && node scripts/externalize-boot.mjs",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
        "test": "vitest run --pool=threads --maxWorkers=2",
        "format": "prettier --write ."
    },
    "devDependencies": {
        "@fontsource/barlow-condensed": "5.3.0",
        "@ibm/plex-mono": "2.5.0",
        "@ibm/plex-sans": "2.0.0",
        "@sveltejs/adapter-static": "4.0.1",
        "@sveltejs/kit": "3.4.0",
        "@sveltejs/vite-plugin-svelte": "7.3.2",
        "@testing-library/svelte": "5.4.2",
        "@testing-library/user-event": "14.6.13",
        "jsdom": "31.0.1",
        "prettier": "3.10.1",
        "prettier-plugin-svelte": "3.5.2",
        "svelte": "5.59.1",
        "svelte-check": "4.7.8",
        "typescript": "6.0.3",
        "vite": "8.3.8",
        "vitest": "5.1.1"
    }
}
